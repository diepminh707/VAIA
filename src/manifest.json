{
  "manifest_version": 3,
  "name": "VAIA - Flow API Extension",
  "version": "1.0.1",
  "description": "Chrome extension to control Google Flow's image and video generation API",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://labs.google.com/*",
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*"
  ],
  "action": {
    "default_title": "VAIA - Flow API Control"
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "background": {
    "service_worker": "background-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google.com/fx/tools/flow/*",
        "https://labs.google/fx/tools/flow/*",
        "https://labs.google.com/fx/*",
        "https://labs.google/fx/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected-script.js"],
      "matches": [
        "https://labs.google.com/*",
        "https://labs.google/*"
      ]
    }
  ]
}
